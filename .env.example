# Local server (npm run dev / npm start)
PORT=3008
HOST=127.0.0.1

# Postgres connection string. On Vercel this is added automatically when you
# connect a Postgres (Neon) database to the project. Leave it unset locally to
# use the embedded PGlite database stored in data/pglite.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: where the local PGlite database lives (default data/pglite).
# PGLITE_DATA_DIR=data/pglite

# Optional extra browser origins allowed to call the API, comma-separated.
# Same-origin requests are always allowed.
# APP_ORIGIN=https://your-domain.example

# Optional transactional email via Resend. Users opt in under Settings.
# Use an address on a verified sending domain. No emails are sent without these.
# RESEND_API_KEY=re_...
# ALERT_EMAIL_FROM=OrganoTale <alerts@your-domain.example>
# APP_URL=https://your-domain.example
# Required for a scheduler calling GET /api/jobs/email with Authorization: Bearer <secret>.
# CRON_SECRET=replace-with-a-long-random-secret
