# Local server (npm run dev / npm start)
PORT=3008
HOST=127.0.0.1

# Postgres connection string. On Vercel this is added automatically when you
# connect a Postgres (Neon) database to the project. Leave it unset locally to
# use the embedded PGlite database stored in data/pglite.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Optional: where the local PGlite database lives (default data/pglite).
# PGLITE_DATA_DIR=data/pglite

# Optional extra browser origins allowed to call the API, comma-separated.
# Same-origin requests are always allowed.
# APP_ORIGIN=https://your-domain.example
