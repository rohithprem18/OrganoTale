{
  "name": "organotale",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c yellow,cyan \"node --watch server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "make-admin": "node server/make-admin.js",
    "test": "node --test server/matching.test.js server/app.test.js",
    "check": "tsc --noEmit",
    "dev:vercel": "vercel dev",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/functions": "^3.9.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2",
    "vercel": "^59.16.0",
    "vite": "^8.3.0"
  }
}
